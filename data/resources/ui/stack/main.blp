using Gtk 4.0;

template $StackPageMain: Box {
	orientation: vertical;
	margin-top: 20;
	margin-bottom: 20;
	margin-start: 20;
	margin-end: 20;
	spacing: 16;

	Box {
		orientation: horizontal;
		spacing: 16;

		Image {
			resource: "/com/ch-naseem/NoidWelcome/images/logo.png";
			pixel-size: 250;
			valign: center;

			accessibility {
				label: "Noid Linux Logo";
			}
		}

		Box {
			orientation: vertical;
			spacing: 6;
			valign: center;

			Label {
				label: _("Welcome to Noid GNU/Linux");
				halign: start;

				styles [
					"title-1",
				]
			}

			Label {
				label: _(
					"This tool provides quick access to software installation, system updates, and setup scripts for virtualization and Rust-based tools."
				);
				halign: start;
				wrap: true;
				max-width-chars: 80;
			}

			Label {
				label: _("\nHave questions or feedback? Don’t hesitate to reach out.");
				halign: start;
				wrap: true;
				max-width-chars: 80;
			}
		}
	}

	ScrolledWindow {
		Box {
			orientation: vertical;
			spacing: 8;
			vexpand: true;

			Button button_get_software {
				label: _("Get software");
				height-request: 48;
				clicked => $on_button_get_software_clicked() swapped;
			}

			Button button_system_update {
				label: _("System update");
				height-request: 48;
				clicked => $on_button_system_update_clicked() swapped;
			}

			Button button_virt_manager {
				label: _("Install virt-manager");
				height-request: 48;
				clicked => $on_button_virt_manager_clicked() swapped;
			}

			Button button_oxidize_system {
				label: _("Oxidize your system");
				height-request: 48;
				clicked => $on_button_oxidize_system_clicked() swapped;
			}
		}
	}

	Box {
		orientation: horizontal;

		LinkButton {
			label: _("Source code");
			uri: "https://forge.ch-naseem.com/noid-linux";
			tooltip-text: _("Source Code");
		}

		LinkButton {
			label: _("Support");
			uri: "https://matrix.to/#/#noid-support:ch-naseem.com";
			tooltip-text: _("Support Matrix channel");
		}

		Box {
			hexpand: true;
			halign: end;
			spacing: 8;

			Label {
				label: _("Launch on startup");
				halign: start;
			}

			Switch switch_autostart {
				valign: center;
				state-set => $on_switch_autostart_state_set() swapped;
			}
		}
	}
}
