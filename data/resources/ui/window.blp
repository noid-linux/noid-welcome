using Gtk 4.0;

template $NoidWelcomeWindow: ApplicationWindow {
  title: "Welcome to Noid Linux";
  default-width: 1000;
  default-height: 600;
  resizable: false;

  child: Stack stack {
    StackPage {
      name: "main";
      child: $StackPageMain stack_page_main {};
    }
    StackPage {
      name: "log";
      child: $StackPageLog stack_page_log {};
    }
  };
}
