#!/usr/bin/env bash
set -euo pipefail

. @SCRIPTSDIR@/common.sh

aliases_conf="
alias \\
  ls='eza --icons=always --group-directories-first' \\
  ll='ls -la --git' \\
  tree='ls -Ta -I \".git\"' \\
  cat='bat --style plain --color=always' \\
  cd='z' \\
  cargo-update='cargo install-update -a'
"

user=$(id -un "$PKEXEC_UID")

echo "Installing Rust toolchain..."
if ! curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sudo -u "$user" sh -s -- -y; then
    echo "Rust installation failed. Exiting."
    exit 1
fi

echo "Installing CLI tools..."
if ! xbps-install -Sy ripgrep bat fd zoxide eza tealdeer dust bottom cargo-update; then
    echo "CLI tools installation failed. Exiting."
    exit 1
fi

echo "Adding aliases to shell configs..."

if grep -q 'AUTO-GENERATED BY NOID TWEAKS' "/home/$user/.zshrc" || grep -q 'AUTO-GENERATED BY NOID TWEAKS' "/home/$user/.bashrc"; then
    echo "Aliases already configured. Skipping setup."
else
    echo "$header$aliases_conf$footer" | tee -a "/home/$user/.zshrc"
    echo "$header$aliases_conf$footer" | tee -a "/home/$user/.bashrc"
fi

echo "Setup complete."
