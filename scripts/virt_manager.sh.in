#!/usr/bin/env bash
set -euo pipefail

. @SCRIPTSDIR@/common.sh

INIT_SYSTEM=$(readlink -n /sbin/init)
REQUIRED_PKGS=(qemu virt-manager virt-viewer dnsmasq vde2 bridge-utils openbsd-netcat libguestfs)
ROOTLESS_USER=$(id -nu "$PKEXEC_UID")

if [[ $INIT_SYSTEM == "dinit" ]]; then
	REQUIRED_PKGS+=(libvirt-dinit)
fi

libvirtd_conf="
unix_sock_group = \"libvirt\"
unix_sock_ro_perms = \"0777\"
unix_sock_rw_perms = \"0770\"
"

qemu_conf="
user = \"$ROOTLESS_USER\"
group = \"$ROOTLESS_USER\"
"

echo "Installing virtualization packages..."
if ! xbps-install -Sy "${REQUIRED_PKGS[@]}"; then
    echo "Package installation failed. Exiting."
    exit 1
fi

echo "Enabling & starting services..."
case $INIT_SYSTEM in
	"runit-init")
		[ ! -f /var/service/libvirtd ] && ln -sf /etc/sv/libvirtd /var/service/libvirtd
		[ ! -f /var/service/virtlogd ] && ln -sf /etc/sv/virtlogd /var/service/virtlogd
		;;
	"dinit")
		dinitctl enable libvirtd
		dinitctl enable virtlogd

		dinitctl start libvirtd
		dinitctl start virtlogd
		;;
	*)
		echo "Couldn't detect init system"
		exit 1
		;;
esac

echo "Configuring libvirtd..."
if grep -q 'AUTO-GENERATED BY NOID TWEAKS' /etc/libvirt/libvirtd.conf; then
    echo "Configuration already applied. Skipping setup."
else
    echo "$header$libvirtd_conf$footer" | tee -a /etc/libvirt/libvirtd.conf > /dev/null
fi

echo "Configuring qemu..."
if grep -q 'AUTO-GENERATED BY NOID TWEAKS' /etc/libvirt/qemu.conf; then
    echo "Configuration already applied. Skipping setup."
else
    echo "$header$qemu_conf$footer" | tee -a /etc/libvirt/qemu.conf > /dev/null
fi

echo "Adding user to libvirt group..."
usermod -aG libvirt "$ROOTLESS_USER"

echo "Adding user to kvm group..."
usermod -aG kvm "$ROOTLESS_USER"

echo "Setup complete. Restart your system for changes to fully take effect."
